NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/agripartners
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
CORS_ORIGIN=https://your-project.vercel.app

NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://test.rpc.fastnear.com
NEAR_WALLET_URL=https://testnet.mynearwallet.com
NEAR_HELPER_URL=https://helper.testnet.near.org
NEAR_CONTRACT_ID=contract.testnet
NEAR_BACKEND_SIGNER_ACCOUNT_ID=backend-signer.testnet
NEAR_BACKEND_SIGNER_PRIVATE_KEY=ed25519:REPLACE_WITH_BACKEND_SIGNER_PRIVATE_KEY
NEAR_INVESTOR_WITHDRAW_SIGNER_ACCOUNT_ID=withdraw-signer.testnet
NEAR_INVESTOR_WITHDRAW_SIGNER_PRIVATE_KEY=ed25519:REPLACE_WITH_WITHDRAW_SIGNER_PRIVATE_KEY

# Variables currently consumed by the Alpha v1 backend.
API_KEY=replace-with-a-long-random-api-key
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_ADMIN_ACCOUNT=backend-signer.testnet
NEAR_ADMIN_PRIVATE_KEY=ed25519:REPLACE_WITH_BACKEND_SIGNER_PRIVATE_KEY
NEAR_INVESTOR_SIGNER_ACCOUNT_ID=withdraw-signer.testnet
NEAR_INVESTOR_SIGNER_PRIVATE_KEY=ed25519:REPLACE_WITH_WITHDRAW_SIGNER_PRIVATE_KEY
ADMIN_EMAIL=admin@example.com
ADMIN_WALLET_ALLOWLIST=admin.testnet
WASM_PATH=./contract/agripartners.wasm
RUN_SEED=false

# Canonical Farmer demo account preparation.
FARMER_DEMO_ACCOUNT_ID=farmer-demo.testnet
FARMER_DEMO_DISPLAY_NAME=Demo Farmer
FARMER_DEMO_PROJECT_ID=4
RESET_FARMER_DEMO_WORKFLOW=false
